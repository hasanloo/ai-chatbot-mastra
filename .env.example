# ==============================================================================
# CLOUD/PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file is for cloud/production deployment (e.g., Vercel)
# For local development with Docker, use .env.local.example instead
# ==============================================================================

# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# The following keys are automatically created when you deploy on Vercel
# You can also create them manually in your Vercel dashboard
# https://vercel.com/docs/concepts/projects/environment-variables

# CLOUD DATABASE (Vercel Postgres, Neon, etc.)
# Instructions: https://vercel.com/docs/storage/vercel-postgres/quickstart
# Must have pgVector extension enabled for @mastra/pg to work
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/ai_chatbot_dev

# LOCAL DEVELOPMENT ALTERNATIVE:
# For local development, copy .env.local.example to .env.local and use:
# POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/ai_chatbot_dev
# Then start the local database with: pnpm db:local:up

# ==============================================================================
# AI PROVIDER CONFIGURATION
# ==============================================================================
# Google Generative AI API Key (required if using Gemini models)
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=****

# OpenAI API Key (required for LongMemEval LLM-as-judge scoring)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=****

